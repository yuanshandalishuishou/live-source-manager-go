# =============================================================
# .dockerignore — 缩减 Docker 构建上下文
# 仅排除「运行期产物 / 无关目录」，绝不排除 Dockerfile 依赖的文件：
#   go.mod  go.sum  main.go  internal/  internal/web/  config/channel_rules.yml
#   start_docker.sh  healthcheck.sh  tools/
# =============================================================

# ===== 版本控制 / 编辑器 / 本机工作目录 =====
.git/
.gitignore
.idea/
.vscode/
.workbuddy/
.github/
.zread/
# 本地环境 / 密钥（绝不可进入构建上下文）
.env
*.env
*.env.local

# ===== 编译产物 / 运行期二进制 =====
bin/
*.exe
*.exe~
*.dll
lsm
lsm-go
# 外部 ffmpeg / ffprobe 二进制（约 180MB，镜像构建期自行下载，绝不可进构建上下文）
tools/ffmpeg/

# ===== 运行期产物（容器首次启动会自行生成/下载，勿进构建上下文）=====
log/
*.log
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
config/online/
config/sources/
www/output/
s1.json
s2.json
src.json

# ===== 文档 / 测试 / 部署脚本（非镜像必需，加速构建）=====
*.md
**/*_test.go
deploy/
docs/
node_modules/

# ===== 系统 / 临时文件 =====
.DS_Store
Thumbs.db
*.swp
*.tmp
# 本机 safe-delete 守卫暂留的临时诊断文件（绝不可进镜像）
_rm_result.txt
