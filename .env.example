# =============================================================
# .env 示例文件 — Live Source Manager (Go 版)
# =============================================================
# 复制为 .env 并按需修改；Docker / docker-compose 会直接读取这些变量。
# 二进制本身通过环境变量或 Web「配置中心」读取，无需此文件也能运行。

# ---- 管理员密码（强烈建议设置；留空则默认 Admin@123）----
LSM_ADMIN_PASSWORD=change_me_strong_password

# ---- 服务端口 / 监听地址（对应 HTTPServer 配置；留空用默认值）----
HOST=0.0.0.0
MANAGER_PORT=23456
FILESHARE_PORT=12345

# ---- ffmpeg / ffprobe（实时测速依赖，可选）----
# 直接指定二进制完整路径，或指定含 ffprobe/ffmpeg 的目录：
# LSM_FFPROBE_PATH=/usr/local/bin/ffprobe
# LSM_FFMPEG_PATH=/usr/local/bin/ffmpeg
# LSM_FFMPEG_DIR=/opt/ffmpeg/bin

# ---- 网络代理（可选；对应 Network 配置，留空默认关闭）----
# LSM_HTTP_PROXY=socks5://127.0.0.1:10808
